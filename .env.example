# Copie este arquivo para ".env" e preencha. Reinicie o "npm run dev" depois de mudar.

# All in One Accessibility (Skynet Technologies): deixe vazio para a versão gratuita
VITE_AIOA_TOKEN=

# Hand Talk (tradução para Libras): token gerado para o domínio do site, na conta da Hand Talk.
# Sem token, a Hand Talk não é carregada.
VITE_HANDTALK_TOKEN=

# Mapa da Trilha: tiles do OpenStreetMap por padrão (uso leve). Para muito acesso, use um provedor com chave
# e informe o endereço no formato https://.../{z}/{x}/{y}.png e o crédito exigido por ele.
VITE_MAPA_TILES=
VITE_MAPA_CREDITO=
